# Server refuses to start without a long API key. Generate it; do not commit it.
ASKDB_API_KEY=
ASKDB_STATE_DIR=.agent-state
# Set ASKDB_LOCAL_MODEL to a downloaded Qwen3 model directory for local inference,
# OR configure the following three hosted OpenAI-compatible values.
ASKDB_LOCAL_MODEL=
ASKDB_LLM_BASE_URL=
ASKDB_LLM_MODEL=
ASKDB_LLM_API_KEY=
# Optional: PostgreSQL SELECT-only analytics role; otherwise the synthetic SQLite demo is used.
ASKDB_POSTGRES_DSN=
